# ─────────────────────────────────────────────────────────────
# Google login (Auth.js / NextAuth v5)
# Copy this file to `.env.local`, fill in the values, then restart the dev server.
# The whole site runs WITHOUT these — only the actual Google sign-in needs them.
# ─────────────────────────────────────────────────────────────

# Show the login UI. Login = cross-device progress sync only (the site is 100% free).
NEXT_PUBLIC_AUTH_ENABLED=true

# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# → "Web application". Add BOTH authorised redirect URIs (local dev + production):
#   http://localhost:3001/api/auth/callback/google
#   https://YOUR-DOMAIN/api/auth/callback/google
# The client ID is public; keep the client SECRET private (never commit it).
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret

# Session-signing secret. Generate one with:  openssl rand -base64 33
AUTH_SECRET=replace-with-a-long-random-string

# trustHost is enabled in auth.ts, so AUTH_URL is NOT required on Vercel —
# just make sure the production redirect URI above is added in Google Console.

# ── Admin 審核面板（/admin）─────────────────────────────────────────────
# Comma-separated founder emails. Only these Google accounts can open /admin and
# record review decisions. Empty/unset = nobody is admin (page just redirects home).
# Set BOTH locally (.env.local) and in the Vercel project env.
ADMIN_EMAILS=founder1@example.com,founder2@example.com

# ── Supabase（progress sync + admin review decisions；server-only）───────
# The project URL is public; the SERVICE ROLE key bypasses RLS —
# never commit it, never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 打氣互助牆（/wall）─────────────────────────────────────────────────
# 一鍵關閉入口（例如審批人手唔夠）。未設＝開。
WALL_ENABLED=true

# 匿名編號「考生 #XXXX」嘅 server 秘密。未設會 fallback 去 AUTH_SECRET，
# 再唔係就用源碼入面嘅公開常數 —— 而個常數任何人睇 repo 都見到，
# 即係知道某個 Google sub 就可以反推佢每日嘅編號。呢個牆面向未成年人，
# 【生產環境必須獨立設一個】，唔好靠 fallback。生成：openssl rand -base64 33
WALL_SALT=replace-with-a-separate-long-random-string

# ── 考試日推送（選配；唔設就成個功能靜靜哋收埋，唔會報錯）─────────────
# 生成方法：node scripts/gen-vapid.mjs
# 佢只會【印出嚟】，一個字都唔會寫入檔案 —— 自己複製去 Vercel 環境變數。
#
# 公鑰會傳去瀏覽器（NEXT_PUBLIC_ 係正常嘅）。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 私鑰係秘密：唔好 commit、唔好貼落任何對話。
VAPID_PRIVATE_KEY=
# 推送服務出事嗰陣搵你嘅方法。要 mailto: 或者 https: 開頭。
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron 叫 /api/cron/exam-day-nudge 嗰陣帶嘅密碼。
# 未設 = 呢條路線一律 503（唔准行）—— 一條任何人 curl 得到嘅推送路線
# 等於一個免費嘅滋擾工具。生成：openssl rand -base64 33
CRON_SECRET=
