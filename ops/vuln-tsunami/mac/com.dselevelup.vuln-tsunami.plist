<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DSE Level Up — Vulnerability Tsunami Defence
  Desktop-only launchd agent. Does NOT touch the official website.
  Install via: bash ops/vuln-tsunami/mac/install-launchd.sh
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dselevelup.vuln-tsunami</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__MONITOR_PATH__</string>
    <string>--hours</string>
    <string>6</string>
    <string>--notify</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__WORKDIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>NOTIFY</key>
    <string>1</string>
  </dict>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/stderr.log</string>
</dict>
</plist>
