// 正解位置按 0→1→2→3 輪轉，避免任何一個位置成為「安全選擇」。
const rotate = <X,>(arr: X[], k: number) =>
  arr.slice(-k % arr.length || arr.length).concat(arr.slice(0, -k % arr.length || arr.length))

const rows = QS.map((qq, i) => {
  const [tid, tzh, ten] = T[qq.t]
  const k = i % 4
  const opts = rotate(qq.o, k)
  return {
    id: `tl_floor_${String(i + 1).padStart(2, '0')}`,
    type: 'mc',
    subject: 'technology-living',
    topic: tzh, topicId: tid, topicZh: tzh, topicEn: ten,
    difficulty: 'basic',
    question: qq.q[0], questionEn: qq.q[1],
    options: opts.map((o) => o[0]), optionsEn: opts.map((o) => o[1]),
    correctIndex: k,
    explanation: qq.e[0], explanationEn: qq.e[1],
  }
})

const OUT = 'scripts/qbank/drafts/technology-living-floor.json'
writeFileSync(OUT, JSON.stringify(rows, null, 2) + '\n')
console.log(`✅ ${rows.length} 條容易題 → ${OUT}`)
