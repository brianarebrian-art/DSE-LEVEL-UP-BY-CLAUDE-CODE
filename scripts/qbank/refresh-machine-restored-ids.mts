// Rebuild data/questions/machine-restored-ids.ts from rationale-repairs.json.
// Those items went back into practice after a program recomputed them.
// A person has not reviewed them. The practice UI labels each one.
//
//   npx --yes tsx@4.19.2 scripts/qbank/refresh-machine-restored-ids.mts

import { readFileSync, writeFileSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..', '..')
const log = JSON.parse(readFileSync(join(ROOT, 'data/questions/rationale-repairs.json'), 'utf8')) as Record<
  string,
  { stage?: string; restoreBasis?: string }
>

const ids = Object.entries(log)
  .filter(([, row]) => row.stage === 'restored' && row.restoreBasis === 'machine-gate')
  .map(([id]) => id)
  .sort()

const body = `// Generated by scripts/qbank/refresh-machine-restored-ids.mts. Do not edit by hand.
// Questions restored by the machine gate, without a person's review.

export const MACHINE_RESTORED_IDS = ${JSON.stringify(ids, null, 2)}

const MACHINE_RESTORED = new Set<string>(MACHINE_RESTORED_IDS)

export function isMachineRestored(questionId: string): boolean {
  return MACHINE_RESTORED.has(questionId)
}
`

writeFileSync(join(ROOT, 'data/questions/machine-restored-ids.ts'), body)
console.log(`machine-restored ids: ${ids.length}`)
