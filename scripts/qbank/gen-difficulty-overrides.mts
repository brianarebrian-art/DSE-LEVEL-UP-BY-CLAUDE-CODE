#!/usr/bin/env -S npx tsx
// ============================================================================
// gen-difficulty-overrides.mts — writes data/questions/difficulty-overrides.generated.ts
// ----------------------------------------------------------------------------
//   npm run qbank:family-difficulty            regenerate
//   npm run qbank:family-difficulty -- --check exit 1 if the file is out of date
//
// Every MC family (data/questions/family.ts) takes one difficulty label.
// Decided by Yuna on 2026-09-26, effective immediately, no per-family sign-off
// (docs/difficulty-family-unification-2026-09-26.md).
//
// The overrides are derived from the labels as written in the source files
// (getSubjectQuestionsRaw), never from the overridden bank, so running this
// twice gives the same file. Rerun after adding or changing questions; the
// test data/questions/__tests__/family-difficulty.test.mts fails while the file is stale.
// Then run `npm run gen:summary` so the bank versions follow.
// ============================================================================
import { readFileSync, writeFileSync } from 'node:fs'
import { join, dirname } from 'node:path'
import { fileURLToPath } from 'node:url'

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..', '..')
const OUT = join(ROOT, 'data/questions/difficulty-overrides.generated.ts')
const CHECK = process.argv.includes('--check')

type Difficulty = 'easy' | 'medium' | 'hard'
type Q = { id: string; type?: string; topic: string; content: string; difficulty: Difficulty }
const load = async <T,>(p: string): Promise<T> => { const m = await import(join(ROOT, p)); return (m.default?.getSubjectQuestionsRaw || m.default?.subjects || m.default?.familyKey ? m.default : m) as T }
const idx = await load<{ getSubjectQuestionsRaw: (id: string) => Q[] }>('data/questions/index.ts')
const { subjects } = await load<{ subjects: { id: string; isActive?: boolean }[] }>('data/subjects.ts')
const fam = await load<{ familyKey: (s: string, q: Q) => string; familyLabel: (l: Difficulty[]) => Difficulty }>('data/questions/family.ts')

const overrides: Record<string, Record<string, Difficulty>> = {}
let changed = 0, families = 0, mixed = 0
for (const s of subjects.filter((x) => x.isActive !== false).map((x) => x.id).sort()) {
  const groups = new Map<string, Q[]>()
  for (const q of idx.getSubjectQuestionsRaw(s)) {
    if ((q.type ?? 'mc') !== 'mc') continue
    const k = fam.familyKey(s, q)
    groups.set(k, [...(groups.get(k) ?? []), q])
  }
  const map: Record<string, Difficulty> = {}
  for (const qs of groups.values()) {
    families++
    const label = fam.familyLabel(qs.map((q) => q.difficulty))
    if (new Set(qs.map((q) => q.difficulty)).size > 1) mixed++
    for (const q of qs) if (q.difficulty !== label) map[q.id] = label
  }
  const ids = Object.keys(map).sort()
  if (ids.length) {
    overrides[s] = Object.fromEntries(ids.map((id) => [id, map[id]]))
    changed += ids.length
  }
}

const body = `// Generated by scripts/qbank/gen-difficulty-overrides.mts. Do not edit by hand.
// One difficulty label per MC family (data/questions/family.ts); Yuna, 2026-09-26.
// ${mixed} of ${families} families had conflicting labels; ${changed} questions are relabelled.
import type { Difficulty } from './types'

export const DIFFICULTY_OVERRIDES: Record<string, Record<string, Difficulty>> = ${JSON.stringify(overrides, null, 1)}
`

if (CHECK) {
  const cur = readFileSync(OUT, 'utf8')
  if (cur !== body) { console.error('difficulty-overrides.generated.ts is out of date: run npm run qbank:family-difficulty'); process.exit(1) }
  console.log(`up to date: ${changed} overrides in ${mixed} families`)
} else {
  writeFileSync(OUT, body)
  console.log(`wrote ${changed} overrides (${mixed} of ${families} families had conflicting labels)`)
}
