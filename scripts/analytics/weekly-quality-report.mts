#!/usr/bin/env npx tsx
/**
 * Weekly question-quality candidate list (privacy-safe aggregates).
 *
 * Reads Supabase via service role when env is present; otherwise prints a
 * skeleton from local SQL view names for founders to run in SQL Editor.
 *
 * Usage:
 *   npx tsx scripts/analytics/weekly-quality-report.mts
 *   npx tsx scripts/analytics/weekly-quality-report.mts --json
 *
 * Never prints emails, names, or raw student answers.
 */

import { writeFileSync } from 'node:fs'

const jsonMode = process.argv.includes('--json')
const week = new Date().toISOString().slice(0, 10)

type Hotspot = {
  question_id: string
  category: string
  report_n: number
  open_n: number
}

async function fetchViaSupabase(): Promise<Hotspot[] | null> {
  const url = process.env.NEXT_PUBLIC_SUPABASE_URL
  const key = process.env.SUPABASE_SERVICE_ROLE_KEY
  if (!url || !key) return null
  const endpoint = `${url.replace(/\/$/, '')}/rest/v1/v_question_report_hotspots?select=*&limit=30`
  const res = await fetch(endpoint, {
    headers: {
      apikey: key,
      Authorization: `Bearer ${key}`,
    },
  })
  if (!res.ok) return null
  const rows = (await res.json()) as Hotspot[]
  return Array.isArray(rows) ? rows : null
}

function skeletonMarkdown(rows: Hotspot[] | null): string {
  const lines = [
    `# 週報 ${week}（香港時間參考日）`,
    '',
    '## 題目庫改善候選（按回報次數）',
    '',
    '| question_id | category | reports | still open |',
    '|---|---|---:|---:|',
  ]
  if (!rows || rows.length === 0) {
    lines.push('| _(no data — apply migration 0029 + run against prod)_ | — | — | — |')
  } else {
    for (const r of rows.slice(0, 25)) {
      lines.push(`| ${r.question_id} | ${r.category} | ${r.report_n} | ${r.open_n} |`)
    }
  }
  lines.push(
    '',
    '## 產品問題（用 SQL views）',
    '',
    '- `v_analytics_topic_practice` — 邊科／課題最多練習完成',
    '- `v_analytics_hard_questions` — 高錯題（n≥5）',
    '- `v_question_report_hotspots` — 多次回報',
    '',
    '## 決策欄（創辦人填）',
    '',
    '1. ',
    '2. ',
    '3. ',
    '',
    '_Generated by scripts/analytics/weekly-quality-report.mts — aggregates only._',
    '',
  )
  return lines.join('\n')
}

const rows = await fetchViaSupabase()
if (jsonMode) {
  process.stdout.write(JSON.stringify({ week, rows: rows ?? [] }, null, 2) + '\n')
} else {
  const md = skeletonMarkdown(rows)
  const out = `docs/analytics/weekly-${week}.md`
  try {
    writeFileSync(out, md)
    console.log(`Wrote ${out}`)
  } catch {
    process.stdout.write(md)
  }
}
