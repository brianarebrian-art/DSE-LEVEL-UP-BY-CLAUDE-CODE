{
  "name": "dse-level-up",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev -p 3001 --webpack",
    "clean": "rm -rf .next",
    "dev:clean": "npm run clean && npm run dev",
    "dev:fresh": "rm -rf .next/dev/cache && npm run dev",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "node scripts/link-typescript7-bin.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "secret:scan": "node scripts/secret-scan.mjs",
    "test": "tsx --test data/questions/__tests__/*.test.mts lib/__tests__/*.test.mts components/__tests__/*.test.mts",
    "gen:questions": "tsx scripts/gen-questions.mts",
    "qbank:queue": "node scripts/qbank/review-queue.mjs",
    "qa": "node scripts/ci/qa.mjs",
    "qa:claims": "node scripts/claims-guard.mjs",
    "qa:contrast": "node scripts/contrast-guard.mjs",
    "qa:emoji": "node scripts/emoji-guard.mjs",
    "term-guard": "node scripts/qbank/term-guard.mjs",
    "tokens:doc": "node scripts/gen-token-doc.mjs",
    "nav:check": "node scripts/guard-nav.mjs",
    "qa:i18n": "node scripts/i18n-guard.mjs",
    "qa:budget": "node scripts/budget-guard.mjs",
    "qa:intel": "node scripts/hkeaa-monitor.mjs",
    "qa:slowsql": "node scripts/db-slow-queries.mjs",
    "baseline": "tsx scripts/qbank/baseline.mts",
    "qbank:sync": "tsx scripts/qbank/sync-questions.mts",
    "qbank:sync:check": "tsx scripts/qbank/sync-questions.mts --check",
    "qbank:verify-en-fix": "node scripts/qbank/verify-en-fix.mjs",
    "qbank:apply-en-fix": "node scripts/qbank/apply-en-fix.mjs",
    "qbank:charscan": "node scripts/qbank/charscan.mjs",
    "qbank:live-charscan": "tsx scripts/qbank/live-charscan.mts",
    "qbank:promote-all": "node scripts/qbank/promote-all.mjs",
    "gen:summary": "tsx scripts/gen-question-summary.mts",
    "gen:study-notes": "tsx scripts/gen-study-notes.mts",
    "qa:copy": "node scripts/copy-guard.mjs",
    "qbank:recalibrate-difficulty": "tsx scripts/qbank/recalibrate-difficulty.mts",
    "qbank:simulate-sampling": "tsx scripts/qbank/simulate-sampling.mts",
    "sync:conflict-repro": "tsx scripts/sync-conflict-repro.mts",
    "analytics:hook-reach": "tsx scripts/analytics/hook-reach.mts",
    "analytics:retention": "tsx scripts/analytics/retention.mts",
    "ops:env-checklist": "tsx scripts/ops/env-checklist.mts",
    "qbank:accuracy-budget": "tsx scripts/qbank/accuracy-budget.mts",
    "qbank:calibrate": "tsx scripts/qbank/calibrate-topic-difficulty.mts",
    "qbank:gap": "tsx scripts/qbank/gap-2027.mts",
    "qbank:family-difficulty": "tsx scripts/qbank/gen-difficulty-overrides.mts",
    "qbank:question-scope": "tsx scripts/qbank/gen-question-scope.mts",
    "error:agent-a": "tsx scripts/error-system/agent-a.mts",
    "error:bot-scan": "tsx scripts/error-system/bot-scan.mts",
    "error:agent-b": "tsx scripts/error-system/agent-b.mts",
    "error:cursor-handoff": "tsx scripts/error-system/cursor-handoff.mts",
    "test:ci": "mkdir -p artifacts && tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=artifacts/tests.xml data/questions/__tests__/*.test.mts lib/__tests__/*.test.mts components/__tests__/*.test.mts"
  },
  "dependencies": {
    "@sentry/nextjs": "11.14.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/speed-insights": "^2.1.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "4.19.2",
    "typescript": "^7"
  },
  "overrides": {
    "sharp": "$sharp",
    "source-map-js": "^1.2.2"
  }
}
