{
  "name": "dse-level-up",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "clean": "rm -rf .next",
    "dev:clean": "npm run clean && npm run dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "npx --yes tsx@4.19.2 --test data/questions/__tests__/*.test.mts lib/__tests__/*.test.mts components/__tests__/*.test.mts",
    "gen:questions": "npx --yes tsx@4.19.2 scripts/gen-questions.mts",
    "qa": "node scripts/qbank/term-guard.mjs && node scripts/qbank/check-posref.mjs --banks && node scripts/qbank/validate-banks.mjs && node scripts/i18n-guard.mjs && node scripts/contrast-guard.mjs && node scripts/claims-guard.mjs && node scripts/integration-guard.mjs && node scripts/responsive-guard.mjs",
    "qa:claims": "node scripts/claims-guard.mjs",
    "qa:contrast": "node scripts/contrast-guard.mjs",
    "term-guard": "node scripts/qbank/term-guard.mjs",
    "qa:i18n": "node scripts/i18n-guard.mjs",
    "qa:budget": "node scripts/budget-guard.mjs",
    "qa:intel": "node scripts/hkeaa-monitor.mjs",
    "qa:slowsql": "node scripts/db-slow-queries.mjs",
    "baseline": "npx --yes tsx@4.19.2 scripts/qbank/baseline.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "better-auth": "^1.6.23",
    "html2canvas": "^1.4.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.20.0",
    "next": "^16.3.2",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
