{
  "name": "dse-level-up",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev -p 3001 --webpack",
    "clean": "rm -rf .next",
    "dev:clean": "npm run clean && npm run dev",
    "dev:fresh": "rm -rf .next/dev/cache && npm run dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "secret:scan": "node scripts/secret-scan.mjs",
    "test": "npx --yes tsx@4.19.2 --test data/questions/__tests__/*.test.mts lib/__tests__/*.test.mts components/__tests__/*.test.mts",
    "gen:questions": "npx --yes tsx@4.19.2 scripts/gen-questions.mts",
    "qbank:queue": "node scripts/qbank/review-queue.mjs",
    "qa": "node scripts/qbank/term-guard.mjs && node scripts/qbank/check-posref.mjs --banks && node scripts/qbank/validate-banks.mjs && node scripts/i18n-guard.mjs && node scripts/contrast-guard.mjs && node scripts/emoji-guard.mjs && node scripts/claims-guard.mjs && node scripts/integration-guard.mjs && node scripts/responsive-guard.mjs && node scripts/barrel-guard.mjs && node scripts/copy-guard.mjs && node scripts/gen-token-doc.mjs --check && node scripts/guard-nav.mjs",
    "qa:claims": "node scripts/claims-guard.mjs",
    "qa:contrast": "node scripts/contrast-guard.mjs",
    "qa:emoji": "node scripts/emoji-guard.mjs",
    "term-guard": "node scripts/qbank/term-guard.mjs",
    "tokens:doc": "node scripts/gen-token-doc.mjs",
    "nav:check": "node scripts/guard-nav.mjs",
    "qa:i18n": "node scripts/i18n-guard.mjs",
    "qa:budget": "node scripts/budget-guard.mjs",
    "qa:intel": "node scripts/hkeaa-monitor.mjs",
    "qa:slowsql": "node scripts/db-slow-queries.mjs",
    "baseline": "npx --yes tsx@4.19.2 scripts/qbank/baseline.mts",
    "qbank:sync": "npx --yes tsx@4.19.2 scripts/qbank/sync-questions.mts",
    "qbank:sync:check": "npx --yes tsx@4.19.2 scripts/qbank/sync-questions.mts --check",
    "qbank:verify-en-fix": "node scripts/qbank/verify-en-fix.mjs",
    "qbank:apply-en-fix": "node scripts/qbank/apply-en-fix.mjs",
    "qbank:charscan": "node scripts/qbank/charscan.mjs",
    "qbank:live-charscan": "npx --yes tsx@4.19.2 scripts/qbank/live-charscan.mts",
    "qbank:promote-all": "node scripts/qbank/promote-all.mjs",
    "gen:summary": "npx --yes tsx@4.19.2 scripts/gen-question-summary.mts",
    "qa:copy": "node scripts/copy-guard.mjs",
    "qbank:recalibrate-difficulty": "npx --yes tsx@4.19.2 scripts/qbank/recalibrate-difficulty.mts",
    "qbank:simulate-sampling": "npx --yes tsx@4.19.2 scripts/qbank/simulate-sampling.mts",
    "sync:conflict-repro": "npx --yes tsx@4.19.2 scripts/sync-conflict-repro.mts",
    "analytics:hook-reach": "npx --yes tsx@4.19.2 scripts/analytics/hook-reach.mts",
    "analytics:retention": "npx --yes tsx@4.19.2 scripts/analytics/retention.mts",
    "ops:env-checklist": "npx --yes tsx@4.19.2 scripts/ops/env-checklist.mts",
    "qbank:accuracy-budget": "npx --yes tsx@4.19.2 scripts/qbank/accuracy-budget.mts",
    "qbank:calibrate": "npx --yes tsx@4.19.2 scripts/qbank/calibrate-topic-difficulty.mts",
    "qbank:gap": "npx --yes tsx@4.19.2 scripts/qbank/gap-2027.mts",
    "qbank:family-difficulty": "npx --yes tsx@4.19.2 scripts/qbank/gen-difficulty-overrides.mts",
    "qbank:question-scope": "npx --yes tsx@4.19.2 scripts/qbank/gen-question-scope.mts",
    "error:agent-a": "npx --yes tsx@4.19.2 scripts/error-system/agent-a.mts",
    "error:bot-scan": "npx --yes tsx@4.19.2 scripts/error-system/bot-scan.mts",
    "error:agent-b": "npx --yes tsx@4.19.2 scripts/error-system/agent-b.mts"
  },
  "dependencies": {
    "@sentry/nextjs": "11.11.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/speed-insights": "^2.0.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^7"
  },
  "overrides": {
    "sharp": "$sharp",
    "source-map-js": "^1.2.2"
  }
}
